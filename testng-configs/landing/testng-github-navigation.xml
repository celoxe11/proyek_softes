<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- 
    GITHUB NAVIGATION TEST
    Test Case:
    1. Arahkan ke menu About
    2. Pilih sub-menu "SuiteCRM Journey"
    3. Tekan button "Support Us on GitHub"
    4. Assert halaman https://github.com/salesagility/SuiteCRM benar
    5. Screenshot hasil assert
    
    Run with: mvn test -DsuiteXmlFile=testng-configs/landing/testng-github-navigation.xml
-->
<suite name="GitHub Navigation Test Suite" verbose="1">
    
    <test name="GitHub Navigation Test" preserve-order="true">
        <classes>
            <class name="com.proyek_softes.landing.tests.GitHubNavigationTest">
                <methods>
                    <include name="testNavigateToGitHub" />
                </methods>
            </class>
        </classes>
    </test>

</suite>
